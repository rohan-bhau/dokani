# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dokani_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# JWT Authentication
JWT_ACCESS_SECRET=your_32_character_minimum_access_secret_here
JWT_REFRESH_SECRET=your_32_character_minimum_refresh_secret_here

# Network & CORS
CORS_ORIGIN=http://localhost:3000

# bKash Sandbox (Optional)
BKASH_APP_KEY=your_bkash_sandbox_app_key
BKASH_APP_SECRET=your_bkash_sandbox_app_secret
BKASH_USERNAME=your_bkash_sandbox_username
BKASH_PASSWORD=your_bkash_sandbox_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# SSLCommerz Sandbox (Optional)
SSLCOMMERZ_STORE_ID=your_sslcommerz_sandbox_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_sandbox_store_passwd
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
