generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(255)
  slug          String       @unique @db.VarChar(100)
  phone         String?      @db.VarChar(20)
  address       String?      @db.Text
  binNumber     String?      @map("bin_number") @db.VarChar(50)
  logoUrl       String?      @map("logo_url") @db.VarChar(500)
  currency            String       @default("BDT") @db.VarChar(3)
  invoicePrefix       String       @default("INV-") @map("invoice_prefix") @db.VarChar(10)
  status              TenantStatus @default(ACTIVE)
  businessType        String?      @map("business_type") @db.VarChar(50)
  paperSize           String       @default("RECEIPT_80MM") @map("paper_size") @db.VarChar(20)
  receiptFooter       String?      @default("Thank you for shopping") @map("receipt_footer") @db.Text
  showLogoOnInvoice   Boolean      @default(true) @map("show_logo_on_invoice")
  showBinOnInvoice    Boolean      @default(true) @map("show_bin_on_invoice")
  showBanglaOnInvoice Boolean      @default(false) @map("show_bangla_on_invoice")
  pricesIncludeVat    Boolean      @default(false) @map("prices_include_vat")
  allowNegativeStock  Boolean      @default(false) @map("allow_negative_stock")
  maxCashierDiscount  Int          @default(5) @map("max_cashier_discount")
  returnApprovalLimit BigInt       @default(200000) @map("return_approval_limit")
  defaultCreditLimit  BigInt?      @map("default_credit_limit")
  overdueDays         Int          @default(15) @map("overdue_days")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  users            User[]
  roles            Role[]
  categories       Category[]
  products         Product[]
  stockMovements   StockMovement[]
  stockLevels      StockLevel[]
  invoices         Invoice[]
  payments         Payment[]
  counters         TenantCounter[]
  customers        Customer[]
  customerLedgers  CustomerLedger[]
  suppliers        Supplier[]
  purchases        Purchase[]
  auditLogs        AuditLog[]
  subscriptions    Subscription[]
  expenses         Expense[]
  saleReturns      SaleReturn[]
  heldCarts        HeldCart[]
  staffInvitations StaffInvitation[]
  notifications    Notification[]

  @@map("tenants")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String    @db.VarChar(100)
  phone            String    @db.VarChar(20)
  email            String?   @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  approvalPin      String?   @map("approval_pin") @db.VarChar(255)
  language         String    @default("en") @db.VarChar(10)
  showBanglaDigits Boolean   @default(false) @map("show_bangla_digits")
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  stockMovementsCreated  StockMovement[]
  invoicesCreated        Invoice[]
  invoicesApproved       Invoice[]        @relation("InvoiceApprover")
  customerLedgersCreated CustomerLedger[]
  purchasesCreated       Purchase[]
  auditLogs              AuditLog[]
  expensesCreated        Expense[]
  saleReturnsCreated     SaleReturn[]
  heldCarts              HeldCart[]
  notifications          Notification[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(50)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  staffInvitations StaffInvitation[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  ADJUSTMENT_DAMAGE
  ADJUSTMENT_EXPIRY
  ADJUSTMENT_CORRECTION
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(100)
  parentId  String?   @map("parent_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  sku          String    @db.VarChar(50)
  barcode      String?   @db.VarChar(50)
  name         String    @db.VarChar(255)
  nameBn       String?   @map("name_bn") @db.VarChar(255)
  categoryId   String?   @map("category_id") @db.Uuid
  unit         String    @default("pcs") @db.VarChar(20)
  costPrice    BigInt    @default(0) @map("cost_price")
  sellPrice    BigInt    @default(0) @map("sell_price")
  vatRate      Int       @default(0) @map("vat_rate")
  reorderLevel Int       @default(5) @map("reorder_level")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  stockLevel     StockLevel?
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]
  saleReturnItems SaleReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  unitCost      BigInt            @map("unit_cost")
  referenceType String?           @map("reference_type") @db.VarChar(50)
  referenceId   String?           @map("reference_id") @db.Uuid
  reason        String?           @db.Text
  createdBy     String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model StockLevel {
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([tenantId, productId])
  @@map("stock_levels")
}

model TenantCounter {
  tenantId    String   @map("tenant_id") @db.Uuid
  counterType String   @map("counter_type") @db.VarChar(50)
  lastValue   BigInt   @default(0) @map("last_value")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, counterType])
  @@map("tenant_counters")
}

enum InvoiceStatus {
  COMPLETED
  VOIDED
  PARTIAL_RETURN
  FULL_RETURN
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  CARD
  CREDIT_BAKI
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(50)
  customerId     String?       @map("customer_id") @db.Uuid
  status         InvoiceStatus @default(COMPLETED)
  subtotal       BigInt        @default(0)
  discount       BigInt        @default(0)
  vatTotal       BigInt        @default(0) @map("vat_total")
  total          BigInt        @default(0)
  paidTotal      BigInt        @default(0) @map("paid_total")
  dueTotal       BigInt        @default(0) @map("due_total")
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(100)
  approverId     String?       @map("approver_id") @db.Uuid
  paymentToken   String?       @unique @map("payment_token") @db.VarChar(100)
  notes          String?       @db.Text
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user        User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  approver    User?         @relation("InvoiceApprover", fields: [approverId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  saleReturns SaleReturn[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice BigInt   @map("unit_price")
  unitCost  BigInt   @map("unit_cost")
  discount  BigInt   @default(0)
  vatRate   Int      @default(0) @map("vat_rate")
  lineTotal BigInt   @map("line_total")
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  invoiceId   String?       @map("invoice_id") @db.Uuid
  customerId  String?       @map("customer_id") @db.Uuid
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(SUCCESS)
  provider    String?       @db.VarChar(50)
  providerRef String?       @map("provider_ref") @db.VarChar(255)
  amount      BigInt
  reference   String?       @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, providerRef])
  @@map("payments")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String?       @map("tenant_id") @db.Uuid
  provider    String        @db.VarChar(50)
  eventId     String        @map("event_id") @db.VarChar(255)
  eventType   String        @map("event_type") @db.VarChar(100)
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

enum CustomerLedgerType {
  SALE_DUE
  PAYMENT_RECEIVED
  RETURN_CREDIT
  OPENING_BALANCE
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(150)
  phone      String   @db.VarChar(20)
  email      String?  @db.VarChar(255)
  address    String?  @db.Text
  dueBalance BigInt   @default(0) @map("due_balance")
  creditLimit BigInt? @map("credit_limit")
  openingDue BigInt   @default(0) @map("opening_due")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  ledger   CustomerLedger[]
  payments Payment[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

model CustomerLedger {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  customerId   String             @map("customer_id") @db.Uuid
  type         CustomerLedgerType
  amount       BigInt
  balanceAfter BigInt             @map("balance_after")
  referenceId  String?            @map("reference_id") @db.Uuid
  notes        String?            @db.Text
  createdBy    String?            @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("customer_ledger")
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(150)
  company        String?  @db.VarChar(150)
  phone          String   @db.VarChar(20)
  email          String?  @db.VarChar(255)
  address        String?  @db.Text
  openingPayable BigInt   @default(0) @map("opening_payable")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, phone])
  @@map("suppliers")
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  supplierId     String         @map("supplier_id") @db.Uuid
  purchaseNumber String         @map("purchase_number") @db.VarChar(50)
  status         PurchaseStatus @default(RECEIVED)
  subtotal       BigInt         @default(0)
  total          BigInt         @default(0)
  paidAmount     BigInt         @default(0) @map("paid_amount")
  dueAmount      BigInt         @default(0) @map("due_amount")
  notes          String?        @db.Text
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid()) @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Int
  unitCost   BigInt   @map("unit_cost")
  lineTotal  BigInt   @map("line_total")
  createdAt  DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_items")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  details    Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Plan {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String       @db.VarChar(100)
  code                String       @unique @db.VarChar(50)
  description         String?      @db.Text
  price               BigInt       @default(0)
  billingCycle        BillingCycle @default(MONTHLY) @map("billing_cycle")
  maxProducts         Int          @default(50) @map("max_products") // -1 for unlimited
  maxStaff            Int          @default(1) @map("max_staff")       // -1 for unlimited
  maxInvoicesPerMonth Int          @default(100) @map("max_invoices_per_month")
  hasAnalytics        Boolean      @default(true) @map("has_analytics")
  hasAuditLogs        Boolean      @default(false) @map("has_audit_logs")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now()) @map("start_date")
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  paymentMethod      String?            @map("payment_method") @db.VarChar(50)
  lastPaymentId      String?            @map("last_payment_id") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([planId])
  @@map("subscriptions")
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  SALARY
  TRANSPORT
  MAINTENANCE
  ENTERTAINMENT
  MARKETING
  OTHER
}

model Expense {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  category  ExpenseCategory
  amount    BigInt
  note      String?         @db.Text
  spentOn   DateTime        @default(now()) @map("spent_on")
  createdBy String?         @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, spentOn])
  @@index([tenantId, category])
  @@map("expenses")
}

enum ReturnReason {
  DAMAGED
  EXPIRED
  CHANGED_MIND
  WRONG_ITEM
  OTHER
}

enum RefundMethod {
  CASH
  BKASH
  CREDIT_ADJUST
}

model SaleReturn {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  returnNumber String        @map("return_number") @db.VarChar(50)
  refundAmount BigInt        @map("refund_amount")
  refundMethod RefundMethod  @default(CASH) @map("refund_method")
  reason       ReturnReason  @default(CHANGED_MIND)
  notes        String?       @db.Text
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creator User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  items   SaleReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, invoiceId])
  @@index([tenantId, createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String     @id @default(uuid()) @db.Uuid
  saleReturnId String     @map("sale_return_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  quantity     Int
  unitPrice    BigInt     @map("unit_price")
  unitCost     BigInt     @map("unit_cost")
  lineTotal    BigInt     @map("line_total")
  createdAt    DateTime   @default(now()) @map("created_at")

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([productId])
  @@map("sale_return_items")
}

model HeldCart {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  cartLabel String   @map("cart_label") @db.VarChar(100)
  cartData  Json     @map("cart_data") @db.JsonB
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, expiresAt])
  @@map("held_carts")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model StaffInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  emailOrPhone String           @map("email_or_phone") @db.VarChar(255)
  name         String           @db.VarChar(100)
  roleId       String           @map("role_id") @db.Uuid
  tokenHash    String           @unique @map("token_hash") @db.VarChar(255)
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime         @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("staff_invitations")
}

enum NotificationType {
  LOW_STOCK
  PAYMENT_RECEIVED
  DUE_OVERDUE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  link      String?          @db.VarChar(255)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}






